@page "/SeleccionarMerch/CreateCompraMerch"

@using AppForSEII2526.Web.Components.Shared
@using AppForSEII2526.Web.API
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager navigation
@inject AppForSEII2526APIClient apiclient
@inject ILogger<SelectCompraMerch> logger
@inject CompraMerchStateContainer merchState
@inject NavigationManager navigation
@attribute [Authorize]

<h3>CreateCompraMerch</h3>
<EditForm Model="compra" OnValidSubmit="OpenDialog">
    <div class="row">
        <DataAnnotationsValidator/>
        <ValidationSummary />
        <ValidationSummary class="row alert alert-danger" />
    </div>
    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @mensajeError</p>
    </div>
    <div class="row g-3">
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="compra.Nombre" class="form-control" id="nombre" />
                <label for="Nombre">Nombre</label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="compra.Apellido_1" class="form-control" id="apellido1" />
                <label for="Nombre">Nombre</label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="compra.Direccion_Envio" class="form-control" id="Direccion_Envio" />
                <label for="Direccion_Envio">Dirección de envio</label>
            </div>
        </div>

    </div>
    <div class="row g-2">
        <div class="col-md">
            <div class="form-floating">
                @* dropdown para el método de pago *@
                <InputSelect TValue="string" @bind-Value="compra.Metodo_Pago" class="form-select" id="MetodoPago">
                    <option value="Tarjeta">Tarjeta</option>
                    <option value="PayPal">PayPal</option>
                    <option value="GooglePay">Google Pay</option>
                </InputSelect>
                <label for="MetodoPago">Método de pago</label>
            </div>
        </div>
    </div>
    <div class="col-md">
            <div class="form-floating">
                @* botón que lanza el diálogo de confirmación *@
                <button class="btn btn-primary" type="submit" id="SubmitPedido" disabled="@compraButtonDisabled">
                    Realizar pedido
                </button>
            </div>
    </div>

    <h4>Detalles de la compra</h4>
    <p>
        <b>Precio total:</b> @PrecioTotal €
        <button class="btn btn-outline-primary" type="submit" @onclick="ModificarCompra" id="ModificarCompra">
            Modificar Compra
        </button>
    </p>
    <div class="mh-100 table-responsive">
        <table class="table table-condensed table-hover" id="CompraMerch">
            <thead>
                <tr>
                    <th>NombreProducto</th>
                    <th>Precio</th>
                    <th>TipoProducto</th>
                    <th>Cantidad</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in compra.MerchItems)
                {
                    <tr id="MovieData_@item.Id">
                        <td>@item.NombreProducto</td>
                        <td>@item.Pvp</td>
                        <td>@item.TipoProducto</td>
                        <td>@item.Cantidad</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</EditForm>
@if (DialogIsOpen)
{
    <Dialog Caption="Comprar Merch"
    Message="¿Quieres seguir y comprar el merch seleccionado?"
    OnClose="@OnDialogClose"
    Type=Dialog.Category.SaveNot>
    </Dialog>
}
@code {
    private bool DialogIsOpen;
    private object? errors;
    private ComprarMerchCreateDTO compra => merchState.Compra;
    private string mensajeError = "";
    private bool compraButtonDisabled
    {
        get { return (compra.MerchItems == null || compra.MerchItems.Count == 0); }
    }

    private bool hideErrors { get { return mensajeError.Length == 0; } }
    private double PrecioTotal
    {
        get
        {
            return merchState.Compra.MerchItems.Sum(item => item.Pvp * item.Cantidad);
        }
    }

    private void ModificarCompra()
    {
        navigation.NavigateTo("/SeleccionarMerch/SelectCompraMerch");
    }
    private void OpenDialog()
    {
        DialogIsOpen = true;
    }

    private async Task OnDialogClose(bool isOk)
    {

        DialogIsOpen = false;
        if (isOk)
        {
            // Process the data introduced by the user if they are valid
            if (compra.MerchItems.Count > 0)
            {
                try
                {
                    var created = await apiclient.CrearCompraMerchAsync(compra);
                    merchState.compraProcesada();
                    navigation.NavigateTo($"/Pedido/DetailPedido/?PedidoID={created.Id}");
                }
                catch (ApiException<ValidationProblemDetails> apiexceptionvalidation)
                {
                    if (apiexceptionvalidation.Result?.Errors?.Values != null)
                    {
                        mensajeError = "";
                        foreach (var errors in apiexceptionvalidation.Result.Errors.Values)
                        {
                            mensajeError = string.Join("(*) ",
                                mensajeError,
                                string.Join(" (*) ", errors));
                        }
                    }
                }
                catch (ApiException)
                {
                    //we need to inform user that there was some other error while processing the request
                    mensajeError = "Error al procesar el pedido, ¡inténtalo más tarde!";
                }
            }


        }
    }
    protected override async Task OnInitializedAsync()
    {

        if (authenticationState is not null)
        {
            var authState = await authenticationState;
            var user = authState?.User;

            if (user is not null)
            {
                if (user.Identity is not null && user.Identity.IsAuthenticated)
                {
                    compra.Nombre = user.Identity.Name;
                }
            }
            compra.Nombre = compra.Nombre == null ? "" : compra.Nombre;
            compra.Apellido_1 = compra.Apellido_1 == null ? "" : compra.Apellido_1;
            compra.Direccion_Envio = compra.Direccion_Envio == null ? "" : compra.Direccion_Envio;

        }
    }


    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }
}
