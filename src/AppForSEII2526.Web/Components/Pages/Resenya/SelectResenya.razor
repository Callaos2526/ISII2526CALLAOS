@using AppForSEII2526.Web
@page "/resenya/selectbocadillos"

@using AppForSEII2526.Web.API
@inject AppForSEII2526APIClient apiclient
@inject ILogger<SelectResenya> logger
@inject ResenyaStateContainer resenyaState

<h3>Select Bocadillos For Reseña</h3>

<div class="container-fluid">

    <div class="row" hidden="@hideErrors">
        <p>@errors</p>
    </div>

    <div class="row">
        <div class="col-8">

            
            <div class="row">

                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text">Nombre</span>
                        <input type="text" class="form-control"
                               @bind="filtroNombre"
                               placeholder="Nombre del bocadillo" />
                    </div>
                </div>

                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text">PVP</span>
                        <input type="number" step="0.1"
                               class="form-control"
                               @bind="filtroPvp"
                               placeholder="Precio exacto" />
                    </div>
                </div>

                <div class="col">
                    <button type="button"
                            class="btn btn-primary"
                            @onclick="SearchBocadillos">
                        Buscar bocadillos
                    </button>
                </div>

            </div>

            <!-- RESULTADOS -->
            <div class="row">

                @if (bocadillos == null)
                {
                    <p>Cargando bocadillos...</p>
                }
                else
                {
                    <p>Numero de bocadillos: @bocadillos.Count</p>

                    <div class="mh-100 table-responsive">
                        <table class="table table-condensed table-hover" id="TableOfBocadillos">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>Tamaño</th>
                                    <th>Tipo Pan</th>
                                    <th>Precio</th>
                                    <th>Añadir</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var b in bocadillos)
                                {
                                    <tr id="BocadilloData_@b.BocadilloID">
                                        <td>@b.NombreBocadillo</td>
                                        <td>@b.Tamano</td>
                                        <td>@b.TipoPanNombre</td>
                                        <td>@b.Pvp €</td>
                                        <td>
                                            <button class="btn btn-outline-secondary"
                                                    @onclick="@(() => AddBocadilloToResenya(b))">
                                                Add
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                    </div>
                }
            </div>

        </div>

        <div class="col-2">
            <h5>Selección</h5>

            @if (resenya.ResenyaBocadillo.Count == 0)
            {
                <p>No hay bocadillos seleccionados aún.</p>
            }
            else
            {
                <ul>
                    @foreach (var item in resenya.ResenyaBocadillo)
                    {
                        <li>@item.BocadilloId (Puntuación: @item.Puntuacion)</li>
                    }
                </ul>
            }
        </div>

    </div>

</div>


@code {

    private ICollection<SelectBocadilloDTO>? bocadillos;

    private string errors = "";
    private bool hideErrors => errors.Length == 0;

    
    private string? filtroNombre { get; set; }
    private float? filtroPvp { get; set; }

    // State container
    private ResenyaForCreateDTO resenya => resenyaState.Resenya;


    private void AddBocadilloToResenya(SelectBocadilloDTO b)
    {
        resenyaState.AddBocadillo(b.BocadilloID, 1);
    }

    public async void SearchBocadillos()
    {
        try
        {
            
            bocadillos = await apiclient.GetBocadilloParaReseñaAsync(filtroNombre, filtroPvp);
        }
        catch (ApiException ex)
        {
            logger.LogError($"{DateTime.Now} Error: {ex}");
            errors = "Error while connecting to the system";
        }

        StateHasChanged();
    }


    protected override Task OnInitializedAsync()
    {
        SearchBocadillos();
        return base.OnInitializedAsync();
    }
}
