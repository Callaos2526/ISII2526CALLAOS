@page "/resenya/selectbocadillos"
@using AppForSEII2526.Web
@using AppForSEII2526.Web.API
@inject AppForSEII2526APIClient apiclient
@inject ILogger<SelectResenya> logger
@inject ResenyaStateContainer resenyaState
@inject NavigationManager navigation

<h3>Seleccionar Bocadillos Para Reseña</h3>

<div class="container-fluid">

    <!-- ERRORES -->
    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">@errors</p>
    </div>

    <div class="row">

        <!-- LISTA DE BOCADILLOS -->
        <div class="col-8">

            <div class="row">
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text">Nombre</span>
                        <input type="text" id="inputNombre"
                               class="form-control"
                               @bind="filtroNombre"
                               placeholder="Nombre del bocadillo" />
                    </div>
                </div>

                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text">PVP</span>
                        <input type="number" id="inputPvp"
                               step="0.1"
                               class="form-control"
                               @bind="filtroPvp"
                               placeholder="Precio exacto" />
                    </div>
                </div>

                <div class="col">
                    <button type="button"
                            id="searchBocadillos"
                            class="btn btn-primary"
                            @onclick="SearchBocadillos">
                        Buscar bocadillos
                    </button>
                </div>
            </div>

            <div class="row">
                @if (bocadillos == null)
                {
                    <p>Cargando bocadillos...</p>
                }
                else
                {
                    <p>Resultados: @bocadillos.Count</p>

                    <div class="table-responsive">
                        <table class="table table-hover" id="TableOfBocadillos">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>Tamaño</th>
                                    <th>Tipo Pan</th>
                                    <th>Precio</th>
                                    <th>Añadir</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in bocadillos)
                                {
                                    <tr id="BocadilloData_@b.BocadilloID">
                                        <td>@b.NombreBocadillo</td>
                                        <td>@b.Tamano</td>
                                        <td>@b.TipoPanNombre</td>
                                        <td>@b.Pvp €</td>
                                        <td>
                                            <button class="btn btn-outline-secondary"
                                                    @onclick="@(() => AddBocadilloToResenya(b))">
                                                Add
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- SELECCIÓN -->
        <div class="col-4">
            <h4>Selección</h4>

            @if (resenya.ResenyaBocadillo.Count == 0)
            {
                <p>No hay bocadillos seleccionados aún.</p>
            }
            else
            {
                <ul class="list-group">
                    @foreach (var item in resenya.ResenyaBocadillo)
                    {
                        <li class="list-group-item list-group-item-action"
                            style="cursor:pointer"
                            @onclick="@(() => RemoveBocadillo(item))">
                            @item.Nombre — Puntuación: @item.Puntuacion
                        </li>
                    }
                </ul>

                <button class="btn btn-primary mt-3"
                        id="goToCreateResenya"
                        @onclick="CrearResenya">
                    Crear reseña
                </button>
            }
        </div>

    </div>
</div>

@code {

    private ICollection<SelectBocadilloDTO>? bocadillos;

    private string errors = "";
    private bool hideErrors => errors.Length == 0;

    private string? filtroNombre;
    private float? filtroPvp;

    private ResenyaForCreateDTO resenya => resenyaState.Resenya;

    private void AddBocadilloToResenya(SelectBocadilloDTO b)
    {
        resenyaState.AddBocadillo(b, 1);
    }

    private void RemoveBocadillo(ResenyaItemDTO item)
    {
        resenyaState.RemoveBocadillo(item);
    }

    private async Task SearchBocadillos()
    {
        try
        {
            bocadillos = await apiclient.GetBocadilloParaReseñaAsync(filtroNombre, filtroPvp);
        }
        catch (ApiException ex)
        {
            logger.LogError(ex.ToString());
            errors = "Error al obtener los bocadillos";
        }

        StateHasChanged();
    }

    private void CrearResenya()
    {
        navigation.NavigateTo("/resenya/createresenya");
    }

    protected override Task OnInitializedAsync()
    {
        resenyaState.OnChange += OnStateChanged;
        SearchBocadillos();
        return base.OnInitializedAsync();
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        resenyaState.OnChange -= OnStateChanged;
    }
}
