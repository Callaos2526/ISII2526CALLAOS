@page "/resenya/createresenya"

@using AppForSEII2526.Web.Components
@using AppForSEII2526.Web.API
@inject AppForSEII2526APIClient apiclient
@inject ILogger<CreateResenya> logger
@inject ResenyaStateContainer resenyaState

<h3>Create Reseña</h3>

@* La reseña que el usuario está editando *@
<EditForm Model="resenya" OnValidSubmit="OpenDialog">
    <div class="row">

        <div class="col-md">
            <div class="form-floating">
                @* Este botón abrirá el diálogo de confirmación *@
                <button class="btn btn-primary" type="submit" id="Submit">
                    Enviar Reseña
                </button>
            </div>
        </div>

    </div>
</EditForm>

@* Modal de confirmación (igual que el profesor) *@
@if (DialogIsOpen)
{
    <Dialog Caption="Crear reseña"
            Message="¿Deseas crear esta reseña?"
            OnClose="@OnDialogClose"
            Type="Dialog.Category.SaveNot">
    </Dialog>
}

@code {

    private bool DialogIsOpen;

    private ResenyaForCreateDTO resenya => resenyaState.Resenya;

    private void OpenDialog()
    {
        DialogIsOpen = true;
    }

    private async Task OnDialogClose(bool isOk)
    {
        DialogIsOpen = false;

        if (isOk)
        {
            // Aquí luego llamaremos apiclient.CreateResenyaAsync(...)
            // cuando lleguemos al commit correspondiente
        }
    }

}
