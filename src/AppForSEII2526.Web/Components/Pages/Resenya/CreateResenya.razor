@page "/resenyas/createresenya"
@inject NavigationManager navigation
@using AppForSEII2526.Web.Components
@using AppForSEII2526.Web.API
@using Microsoft.AspNetCore.Authorization
@inject AppForSEII2526APIClient apiclient
@inject ILogger<CreateResenya> logger
@inject ResenyaStateContainer resenyaState

@attribute [Authorize]

<h3>Create Reseña</h3>

<EditForm Model="resenya" OnValidSubmit="OpenDialog">
    <div class="row">
        <DataAnnotationsValidator />
        <ValidationSummary class="row alert alert-danger" />
    </div>

    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errores: @messageError</p>
    </div>

    <div class="row g-3">
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="resenya.NombreUsuario" class="form-control" id="NombreUsuario" />
                <label for="NombreUsuario">Nombre usuario (opcional)</label>
            </div>
        </div>

        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="resenya.Titulo" class="form-control" id="Titulo" />
                <label for="Titulo">Título</label>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="form-floating mb-3">
                <InputTextArea @bind-Value="resenya.Descripcion" class="form-control" id="Descripcion" />
                <label for="Descripcion">Descripción</label>
            </div>
        </div>

        <div class="col-md-3">
            <div class="form-floating mb-3">
                <InputSelect class="form-select" @bind-Value="resenya.Valoracion" id="Valoracion">
                    <option value="UnaEstrella">★</option>
                    <option value="DosEstrellas">★★</option>
                    <option value="TresEstrellas">★★★</option>
                    <option value="CuatroEstrellas">★★★★</option>
                    <option value="CincoEstrellas">★★★★★</option>
                </InputSelect>
                <label for="Valoracion">Valoración General</label>
            </div>
        </div>

        <div class="col-md">
            <div class="form-floating">
                
                <button class="btn btn-primary" type="submit" id="Submit">
                    Crear reseña
                </button>
            </div>
        </div>
    </div>

    <h4>Detalle de la reseña</h4>

    <p><b>Número de bocadillos:</b> @resenya.NumeroDeBocadillos</p>

    <p>
        <button class="btn btn-outline-primary" @onclick="ModifyItems">
            Modificar bocadillos
        </button>
    </p>

    <div class="mh-100 table-responsive">
        <table class="table table-condensed table-hover" id="TableOfResenyaItems">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Precio</th>
                    <th>Tamaño</th>
                    <th>Puntuación</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in resenya.ResenyaBocadillo)
                {
                    <tr id="BocadilloData_@item.BocadilloId">
                        <td>@item.Nombre</td>
                        <td>@item.Pvp</td>
                        <td>@item.Tamano</td>
                        <td>
                            <InputNumber @bind-Value="item.Puntuacion"
                                         class="form-control"
                                         min="1" max="10"
                                         id="@($"puntuacion_{item.BocadilloId}")" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</EditForm>


@if (DialogIsOpen)
{
    <Dialog Caption="Crear reseña"
            Message="¿Deseas enviar esta reseña?"
            OnClose="@OnDialogClose"
            Type="Dialog.Category.SaveNot">
    </Dialog>
}

@code {

    private string messageError = "";
    private bool hideErrors { get { return messageError.Length == 0; } }

    private bool DialogIsOpen;

    private ResenyaForCreateDTO resenya => resenyaState.Resenya;


    private void ModifyItems()
    {
        navigation.NavigateTo("/resenya/selectbocadillos");
    }

    private void OpenDialog()
    {
        DialogIsOpen = true;
    }

    private async Task OnDialogClose(bool isOk)
    {
        DialogIsOpen = false;

        if (isOk)
        {
            if (resenya.ResenyaBocadillo.Count > 0)
            {
                try
                {
                    var result = await apiclient.CreateResenyaAsync(resenya);
                    resenyaState.ResenyaProcessed();
                    navigation.NavigateTo($"/resenya/detailresenya/?ResenyaID={result.Id}");
                }
                catch (ApiException<ValidationProblemDetails> apiexceptionvalidation)
                {
                    if (apiexceptionvalidation.Result.Errors.Values != null)
                    {
                        messageError = "";
                        foreach (var errors in apiexceptionvalidation.Result.Errors.Values)
                            messageError = string.Join("(*) ", messageError, string.Join(" (*) ", errors));
                    }
                }
                catch (ApiException)
                {
                    messageError = "Error al procesar la reseña, por favor inténtalo más tarde.";
                }
            }
        }
    }

    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (authenticationState is not null)
        {
            var authState = await authenticationState;
            var user = authState?.User;

            if (user is not null && user.Identity is not null && user.Identity.IsAuthenticated)
            {
                resenya.NombreUsuario = user.Identity.Name;
            }

            resenya.Titulo = resenya.Titulo ?? "";
            resenya.Descripcion = resenya.Descripcion ?? "";
        }
    }
}
