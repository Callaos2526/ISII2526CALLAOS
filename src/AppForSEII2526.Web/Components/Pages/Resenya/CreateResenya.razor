@page "/resenya/createresenya"
@inject NavigationManager navigation
@using AppForSEII2526.Web.Components.Shared
@using AppForSEII2526.Web.API
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject AppForSEII2526APIClient apiclient
@inject ILogger<CreateResenya> logger
@inject ResenyaStateContainer resenyaState

<h3>Crear Reseña</h3>

<EditForm Model="resenya" OnSubmit="OpenDialog">
    <DataAnnotationsValidator />
    <ValidationSummary class="alert alert-danger" />

    <div class="row g-3">
        <div class="col-md">
            <InputText @bind-Value="resenya.NombreUsuario"
                       class="form-control"
                       id="NombreUsuario"
                       placeholder="Nombre usuario (opcional)" />
        </div>

        <div class="col-md">
            <InputText @bind-Value="resenya.Titulo"
                       class="form-control"
                       id="Titulo"
                       placeholder="Título" />
        </div>
    </div>

    <div class="row g-3 mt-2">
        <div class="col-md-6">
            <InputTextArea @bind-Value="resenya.Descripcion"
                           class="form-control"
                           id="Descripcion"
                           placeholder="Descripción" />
        </div>

        <div class="col-md-3">
            <InputSelect class="form-select"
                         @bind-Value="resenya.Valoracion"
                         id="Valoracion">
                <option value="Uno">Uno</option>
                <option value="Dos">Dos</option>
                <option value="Tres">Tres</option>
                <option value="Cuatro">Cuatro</option>
                <option value="Cinco">Cinco</option>
            </InputSelect>
        </div>

        <div class="col-md">
            <button class="btn btn-primary"
                    type="submit"
                    id="Submit">
                Crear reseña
            </button>
        </div>
    </div>

    <h4 class="mt-4">Detalle de la reseña</h4>
    <p><b>Número de bocadillos:</b> @resenya.ResenyaBocadillo.Count</p>

    <button class="btn btn-outline-primary"
            type="button"
            id="ModifyBocadillos"
            @onclick="ModifyItems">
        Modificar bocadillos
    </button>

    <table class="table mt-3" id="TableOfResenyaItems">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Precio</th>
                <th>Tamaño</th>
                <th>Puntuación</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in resenya.ResenyaBocadillo)
            {
                <tr id="BocadilloData_@item.BocadilloId">
                    <td>@item.Nombre</td>
                    <td>@item.Pvp €</td>
                    <td>@item.Tamano</td>
                    <td>
                        <InputNumber @bind-Value="item.Puntuacion"
                                     min="1" max="10"
                                     class="form-control" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
</EditForm>

@if (DialogIsOpen)
{
    <Dialog Caption="Crear reseña"
            Message="¿Deseas enviar esta reseña?"
            OnClose="OnDialogClose"
            Type="Dialog.Category.SaveNot" />
}

@code {
    private bool DialogIsOpen;
    private ResenyaForCreateDTO resenya => resenyaState.Resenya;

    private void OpenDialog()
    {
        DialogIsOpen = true;
    }

    private async Task OnDialogClose(bool isOk)
    {
        DialogIsOpen = false;

        if (!isOk) return;

        if (resenya.ResenyaBocadillo.Count == 0)
            return;

        var created = await apiclient.CreateResenyaAsync(resenya);
        resenyaState.ResenyaProcessed();
        navigation.NavigateTo($"/resenya/detailresenya/?ResenyaID={created.Id}");
    }

    private void ModifyItems()
    {
        navigation.NavigateTo("/resenya/selectbocadillos");
    }
}
