@page "/resenya/detailresenya"

@using AppForSEII2526.Web.API
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject AppForSEII2526APIClient apiclient
@inject ILogger<DetailsResenya> logger

<h3>Detalle de la Reseña</h3>


@if (resenya == null)
{
    <p id="ErrorMessage">@error</p>
}
else
{
    <table class="table table-borderless table-sm">
        <tr>
            <th>Usuario</th>
            <td id="NombreUsuario">@resenya.NombreUsuario</td>
        </tr>
        <tr>
            <th>Fecha Publicación</th>
            <td id="FechaPublicacion">@resenya.FechaPublicacion.ToString("dd/MM/yyyy HH:mm:ss")</td>
        </tr>
        <tr>
            <th>Título</th>
            <td id="Titulo">@resenya.Titulo</td>
        </tr>
        <tr>
            <th>Descripción</th>
            <td id="Descripcion">@resenya.Descripcion</td>
        </tr>
        <tr>
            <th>Valoración general</th>
            <td id="Valoracion">@resenya.Valoracion</td>
        </tr>
    </table>

    <h4>Bocadillos puntuados</h4>

    <table class="table" id="ResenyaBocadillos">
        <thead>
            <tr>
                <th scope="col">Nombre</th>
                <th scope="col">PVP</th>
                <th scope="col">Tamaño</th>
                <th scope="col">Puntuación</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in resenya.ResenyaBocadillo)
            {
                <tr id="ResenyaItem_@item.BocadilloId">
                    <td>@item.Nombre</td>
                    <td>@item.Pvp</td>
                    <td>@item.Tamano</td>
                    <td>@item.Puntuacion</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {

    [Parameter]
    [SupplyParameterFromQuery]
    public int ResenyaID { get; set; }

    private ResenyaDetailDTO? resenya;
    private string error = string.Empty;

    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        string userName = "";

        if (authenticationState is not null)
        {
            var authState = await authenticationState;
            var user = authState?.User;

            if (user is not null &&
                user.Identity is not null &&
                user.Identity.IsAuthenticated &&
                user.IsInRole("User"))
            {
                userName = user.Identity.Name ?? "";
            }
        }

        logger.LogDebug("Usuario autenticado: {UserName}", userName);

        try
        {
            resenya = await apiclient.GetResenyaAsync(ResenyaID);
        }
        catch (ApiException ex)
        {
            logger.LogError($"{DateTime.Now} Error al obtener reseña: {ex}");
            resenya = null;
        }

        if (resenya == null)
        {
            error = $"Error! No existe la reseña con id={ResenyaID} o no se pudo recuperar.";
        }
    }
}
