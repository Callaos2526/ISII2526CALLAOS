@page "/Pedido/CreatePedido"
@inject NavigationManager navigation
@using AppForSEII2526.Web.Components.Shared
@using AppForSEII2526.Web.API
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject AppForSEII2526APIClient apiclient
@inject ILogger<CreatePedido> logger
@inject PedidoStateContainer pedidoState



<h3>Crear Pedido</h3>


<EditForm Model="pedido" OnValidSubmit="OpenDialog">
    <div class="row">
        <DataAnnotationsValidator />
        <ValidationSummary class="row alert alert-danger" />
    </div>

    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @messageError</p>
    </div>

    <div class="row g-3">
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="pedido.NombreCliente" class="form-control" id="Name" />
                <label for="Name">Nombre</label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="pedido.ApellidoCliente1" class="form-control" id="Surname1" />
                <label for="Surname1">Primer apellido</label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="pedido.ApellidoCliente2" class="form-control" id="Surname2" />
                <label for="Surname2">Segundo apellido (opcional)</label>
            </div>
        </div>
    </div>

    <div class="row g-2">
        <div class="col-md">
            <div class="form-floating">
                @* dropdown para el método de pago adaptado a tus opciones *@
                <InputSelect TValue="string" @bind-Value="pedido.Metodo" class="form-select" id="MetodoPago">
                    <option value="Tarjeta">Tarjeta</option>
                    <option value="PayPal">PayPal</option>
                    <option value="GooglePay">Google Pay</option>
                </InputSelect>
                <label for="MetodoPago">Método de pago</label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating">
                @* botón que lanza el diálogo de confirmación *@
                <button class="btn btn-primary" type="submit" id="SubmitPedido" disabled="@pedidoButtonDisabled">
                    Realizar pedido
                </button>
            </div>
        </div>
    </div>

    <h4>Detalle del pedido</h4>
    <p>
        <b>Total precio:</b> @TotalPrice € 
        <button class="btn btn-outline-primary" type="submit" @onclick="ModifyBocadillos" id="ModifyBocadillos">
            Modificar bocadillos
        </button>
    </p>

    <div class="mh-100 table-responsive">
        <table class="table table-condensed table-hover" id="TableOfPedidoItems">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Tipo Pan</th>
                    <th>Cantidad</th>
                    <th>Precio unidad</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in pedido.BocadilloItem)
                {
                    <tr id="BocadilloData_@item.Id">
                        <td>@item.NombreBocadillo</td>
                        <td>@item.TipoPan</td>
                        <td>
                            <InputNumber TValue="int"
                                         @bind-Value="item.Cantidad"
                                         class="form-control"
                                         id="@($"cantidad_{item.Id}")" />
                        </td>
                        <td>@item.Pvp.ToString("F2") €</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</EditForm>

@if (DialogIsOpen)
{
    <Dialog Caption="Confirmar pedido"
            Message="¿Deseas confirmar el pedido con los datos actuales?"
            OnClose="@OnDialogClose"
            Type=Dialog.Category.SaveNot>
    </Dialog>
}

@code {
    private string messageError = "";
    private bool hideErrors { get { return messageError.Length == 0; } }
    //rentalbutton will be disabled if there are not movies in the renting cart
    private bool pedidoButtonDisabled
    {
        get { return (pedido.BocadilloItem == null || pedido.BocadilloItem.Count == 0); }
    }

    private bool DialogIsOpen;

    private decimal TotalPrice
    {
        get
        {
            double price = pedido.BocadilloItem.Sum(b => (double)b.Pvp * b.Cantidad);
            return Convert.ToDecimal(price);
        }
    }

    private void ModifyBocadillos()
    {
        navigation.NavigateTo("/Pedido/SelectBocadillosParaPedir");
    }

    private CreatePedidoDTO pedido => pedidoState.Pedido;

    private void OpenDialog()
    {
        DialogIsOpen = true;
    }

    private async Task OnDialogClose(bool isOk)
    {
        DialogIsOpen = false;

        if (isOk)
        {
            // Process the data introduced by the user if they are valid
            if (pedido.BocadilloItem.Count > 0)
            {
                try
                {
                    var created = await apiclient.CrearPedidoAsync(pedido);
                    pedidoState.PedidoProcessed();
                    navigation.NavigateTo($"/Pedido/DetailPedido/?PedidoID={created.Id}");
                }
                catch (ApiException<ValidationProblemDetails> apiexceptionvalidation)
                {
                    if (apiexceptionvalidation.Result?.Errors?.Values != null)
                    {
                        messageError = "";
                        foreach (var errors in apiexceptionvalidation.Result.Errors.Values)
                        {
                            messageError = string.Join("(*) ",
                                messageError,
                                string.Join(" (*) ", errors));
                        }
                    }
                }
                catch (ApiException)
                {
                    //we need to inform user that there was some other error while processing the request
                    messageError = "Error al procesar el pedido, ¡inténtalo más tarde!";
                }
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (authenticationState is not null)
        {
            var authState = await authenticationState;
            var user = authState?.User;

            if (user is not null && user.Identity is not null && user.Identity.IsAuthenticated)
            {
                // aquí solo registro el usuario porque no tenemos UserName en el DTO
                var userName = user.Identity.Name ?? string.Empty;
                logger.LogDebug("Usuario autenticado: {UserName}", userName);
            }

            pedido.NombreCliente = pedido.NombreCliente == null ? "" : pedido.NombreCliente;
            pedido.ApellidoCliente1 = pedido.ApellidoCliente1 == null ? "" : pedido.ApellidoCliente1;
            pedido.ApellidoCliente2 = pedido.ApellidoCliente2 == null ? "" : pedido.ApellidoCliente2;
            pedido.Metodo = pedido.Metodo == null ? "" : pedido.Metodo;
        }
    }

    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }
}