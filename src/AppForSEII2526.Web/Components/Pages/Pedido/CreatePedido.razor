@page "/Pedido/CreatePedido"
@inject NavigationManager navigation
@using AppForSEII2526.Web.Components.Shared
@using AppForSEII2526.Web.API
@using Microsoft.AspNetCore.Authorization
@inject AppForSEII2526APIClient apiclient
@inject ILogger<CreatePedido> logger
@inject PedidoStateContainer pedidoState

<!--[Authorize]-->

<h3>Crear Pedido</h3>


<EditForm Model="pedido" OnValidSubmit="OpenDialog">
    <div class="row">
        <DataAnnotationsValidator />
        <ValidationSummary class="row alert alert-danger" />
    </div>

    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @messageError</p>
    </div>

    <div class="row g-3">
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="pedido.NombreCliente" class="form-control" id="NombreCliente" />
                <label for="NombreCliente">Nombre</label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="pedido.ApellidoCliente1" class="form-control" id="Apellido1" />
                <label for="Apellido1">Primer apellido</label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="pedido.ApellidoCliente2" class="form-control" id="Apellido2" />
                <label for="Apellido2">Segundo apellido (opcional)</label>
            </div>
        </div>
    </div>

    <div class="row g-2">
        <div class="col-md">
            <div class="form-floating">
               
                <InputText @bind-Value="pedido.Metodo" class="form-control" id="MetodoPago" />
                <label for="MetodoPago">Método de pago</label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating">
                <button class="btn btn-primary" type="submit" id="SubmitPedido">
                    Realizar pedido
                </button>
            </div>
        </div>
    </div>

    <h4>Detalle del pedido</h4>
    <p>
        <b>Total precio:</b> @TotalPriceFormatted €
        <button class="btn btn-outline-primary" type="submit" @onclick="ModifyBocadillos" id="ModifyBocadillos">
            Modificar bocadillos
        </button>
    </p>

    <div class="mh-100 table-responsive">
        <table class="table table-condensed table-hover" id="TableOfPedidoItems">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Tipo Pan</th>
                    <th>Cantidad</th>
                    <th>Precio unidad</th>
                </tr>
            </thead>
            <tbody>
               
                    @foreach (var item in pedido.BocadilloItem)
                    {
                        <tr id="BocadilloData_@item.ID">
                            <td>@item.NombreBocadillo</td>
                            <td>@item.TipoPan</td>
                            <td> <InputNumber @bind-Value="item.Cantidad" class="form-control" id="@($"cantidad_{item.ID}")" /></td>
                            
                            <td>@item.Pvp.ToString("F2") €</td>
                        </tr>
                    }
                
            </tbody>
        </table>
    </div>
</EditForm>


@if (DialogIsOpen)
{
    <Dialog Caption="Confirmar pedido"
            Message="¿Deseas confirmar el pedido con los datos actuales?"
            OnClose="@OnDialogClose"
            Type="Dialog.Category.SaveNot">
    </Dialog>
}

@code {
    private string messageError = "";
    private bool hideErrors { get { return messageError.Length == 0; } }
    private bool DialogIsOpen;

    private string TotalPriceFormatted => TotalPrice.ToString("F2");
    private decimal TotalPrice
    {
        get
        {
           
            var total = pedido?.BocadilloItem?.Sum(i => Convert.ToDecimal(i.Pvp) * i.Cantidad) ?? 0m;
            return total;
        }
    }

    private void ModifyBocadillos()
    {
        navigation.NavigateTo("/Pedido/SelectBocadillosParaPedir");
    }

    private CreatePedidoDTO pedido => pedidoState.Pedido;

    private void OpenDialog()
    {
        DialogIsOpen = true;
    }

    private async Task OnDialogClose(bool isOk)
    {
        DialogIsOpen = false;
        if (isOk)
        {
            
            if (pedido.BocadilloItem != null && pedido.BocadilloItem.Count > 0)
            {
                try
                {
                    var created = await apiclient.CrearPedidoAsync(pedido);
                    pedidoState.PedidoProcessed();
                    navigation.NavigateTo($"/Pedido/DetailPedido/?PedidoID={created.Id}");
                }
                catch (ApiException<ValidationProblemDetails> apiexceptionvalidation)
                {
                    if (apiexceptionvalidation.Result?.Errors?.Values != null)
                    {
                        messageError = "";
                        foreach (var errors in apiexceptionvalidation.Result.Errors.Values)
                            //https://learn.microsoft.com/en-us/dotnet/api/system.string.join?view=net-7.0
                            messageError = string.Join("(*) ", messageError, string.Join(" (*) ", errors));
                    }
                }
                catch (ApiException apiexception)
                {
                      messageError = "Error al procesar el pedido, intentalo mas tarde!";
                }
            }
        }
    }
    protected override async Task OnInitializedAsync()
    {
        if (authenticationState is not null)
        {
            var authState = await authenticationState;
            var user = authState?.User;

            if (user is not null)
            {
                if (user.Identity is not null && user.Identity.IsAuthenticated)
                {
                    // Nuestro DTO `CreatePedidoDTO` no tiene `UserNameCustomer`, por eso no la asigno aquí.
                    // La comprobación de propietario y la autorización final las hemos realizado en el servidor.

                     var userName = user.Identity?.Name ?? string.Empty;
                    logger.LogDebug("Usuario autenticado: {UserName}", userName);

                    if (string.IsNullOrWhiteSpace(pedido.NombreCliente) && !string.IsNullOrWhiteSpace(userName))
                    {
                        pedido.NombreCliente = userName;
                    }
                }
            }

            pedido.NombreCliente = pedido.NombreCliente == null ? "" : pedido.NombreCliente;
            pedido.ApellidoCliente1 = pedido.ApellidoCliente1 == null ? "" : pedido.ApellidoCliente1;
            pedido.ApellidoCliente2 = pedido.ApellidoCliente2 == null ? "" : pedido.ApellidoCliente2;
            pedido.Metodo = pedido.Metodo == null ? "" : pedido.Metodo;
        }
    }

    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }
}