@page "/ComprarBono/SelectBonoUI"
@using AppForSEII2526.Web.API
@inject AppForSEII2526APIClient apiclient
@inject ILogger<SelectBonoUI> logger
@inject BonoStateContainer bonoState
@inject NavigationManager navigation

<h3>Seleccionar Bono</h3>

<div class="container-fluid">
    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @errors</p>
    </div>

    <div class="row">
        <div class="col-8">
            <div class="row">
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Nombre</span>
                        <input type="text" id="inputNombre" @bind="filtroNombre" class="form-control" placeholder="Nombre" aria-label="Nombre" aria-describedby="basic-addon1" />
                    </div>
                </div>
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon2">Tipo</span>
                        <input type="text" id="inputTipo" @bind="filtroTipo" class="form-control" placeholder="Tipo" aria-label="Tipo" aria-describedby="basic-addon2" />
                    </div>
                </div>
                <div class="col">
                    <button type="button" class="btn btn-primary" @onclick="BuscarBonos" id="BuscarBonos">Buscar Bonos</button>
                </div>
            </div>

            <div class="row">
                @if (bonos == null)
                {
                    <p>Loading bonos....</p>
                }
                else
                {
                    <div class="mh-100 table-responsive">
                        <table class="table table-condensed table-hover" id="TablaDeBonos">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>Tipo</th>
                                    <th>Nº Bocadillos</th>
                                    <th>Precio</th>
                                    <th>Añadir</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (bonos.Count == 0)
                                {
                                    @* tabla vacía cuando no hay resultados *@
                                }
                                else
                                {
                                    @foreach (var item in bonos)
                                    {
                                        <tr id="BonoData_@item.BonoID">
                                            <td>@item.Nombre</td>
                                            <td>@item.Tipo</td>
                                            <td>@item.NumeroDeBocadillos</td>
                                            <td>@item.Precio</td>
                                            <td>
                                                <button class="btn btn-outline-secondary"
                                                        id="addBono_@item.BonoID" @onclick="@(() => AddBonoToCart(item))">Add</button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    @* Mostrar mensaje inline además del modal (de respaldo) *@
                    @if (showNoResultsMessage)
                    {
                        <div class="alert alert-info mt-2" id="NoBonosMessage" role="status" aria-live="polite">
                            El filtro introducido es incorrecto
                        </div>
                    }
                }
            </div>
        </div>

        <div class="col-4">
            <div class="col-12" hidden="@HideCart">
                <div class="row"><h4>Carrito de la compra</h4></div>

                @foreach (var item in compra.BonoItem)
                {
                    <div class="row mb-2">
                        <div class="col">
                            <button type="button" class="btn btn-light"
                                    id="removeBono_@item.BonoId" @onclick="@(() => RemoveBonoItem(item))">
                                x @item.Nombre - @item.Precio€ (x @item.Cantidad)
                            </button>
                        </div>
                    </div>
                }

                <div class="row mt-2">
                    <div class="col">
                        <p id="cartTotal">Total: @bonoState.TotalPrice €</p>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <button type="button" class="btn btn-primary"
                                id="btnProcesarCompra"
                                @onclick="ProceedToCreatePurchase">
                            Procesar compra
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-12" hidden="@(compra.BonoItem.Count > 0)">
                <p>El carrito está vacío</p>
            </div>
        </div>
    </div>
</div>

@* Modal de "filtro incorrecto" *@
@if (showNoResultsModal)
{
    <div class="modal fade show" id="NoBonosModal" style="display:block;" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Filtro incorrecto</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseNoBonosModal"></button>
                </div>
                <div class="modal-body">
                    <p>El filtro introducido es incorrecto</p>
                </div>
                <div class="modal-footer">
                    <button id="NoBonosModal_Ok" class="btn btn-primary" @onclick="CloseNoBonosModal">Aceptar</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private System.Collections.Generic.ICollection<SelectBonoDTO>? bonos;
    private string errors = string.Empty;
    private bool hideErrors => string.IsNullOrEmpty(errors);

    private string filtroNombre { get; set; } = string.Empty;
    private string filtroTipo { get; set; } = string.Empty;

    private bool HideCart => !compra.BonoItem.Any();

    // Exponer la compra desde el state container
    private CrearCompraDTO compra => bonoState.Compra;

    // Modal / mensaje control
    private bool showNoResultsModal = false;
    private bool showNoResultsMessage = false;

    private void ProceedToCreatePurchase()
    {
        navigation.NavigateTo("/ComprarBono/CreateCompra");
    }

    private void AddBonoToCart(SelectBonoDTO item)
    {
        try
        {
            bonoState.AddProduct(item);
            errors = string.Empty;
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error añadiendo bono al carrito");
            errors = "Error añadiendo bono al carrito";
        }
        StateHasChanged();
    }

    private void RemoveBonoItem(BonoItemForCreateDTO item)
    {
        if (item == null) return;
        bonoState.RemoveItem(item);
        StateHasChanged();
    }

    private async Task BuscarBonos()
    {
        try
        {
            var nombre = string.IsNullOrWhiteSpace(filtroNombre) ? null : filtroNombre;
            var tipo = string.IsNullOrWhiteSpace(filtroTipo) ? null : filtroTipo;

            var result = await apiclient.GetBonoParaCompraAsync(nombre, tipo);
            bonos = result?.ToList() ?? new System.Collections.Generic.List<SelectBonoDTO>();

            // Mostrar modal/mensaje sólo si el usuario introdujo algún filtro y no hay resultados
            var filtersProvided = !string.IsNullOrWhiteSpace(filtroNombre) || !string.IsNullOrWhiteSpace(filtroTipo);
            showNoResultsModal = filtersProvided && bonos.Count == 0;
            showNoResultsMessage = filtersProvided && bonos.Count == 0;

            errors = string.Empty;
        }
        catch (ApiException ex)
        {
            logger.LogError(ex, "Error buscando bonos");
            errors = "Error while connecting to the system";
            bonos = new System.Collections.Generic.List<SelectBonoDTO>();
            showNoResultsModal = false;
            showNoResultsMessage = false;
        }
        StateHasChanged();
    }

    private void CloseNoBonosModal()
    {
        showNoResultsModal = false;
        StateHasChanged();
    }

    // Cargar todos los bonos al inicializar la página (sin necesidad de usar filtros)
    protected override async Task OnInitializedAsync()
    {
        await BuscarBonos();
    }
}