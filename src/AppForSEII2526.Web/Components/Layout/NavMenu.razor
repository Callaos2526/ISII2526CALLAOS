@implements IDisposable
@inject NavigationManager NavigationManager

<style>
    /* 1. FONDO Y CONTENEDOR */
    .nav-scrollable {
        background-color: #212529;
    }

    /* 2. ESTILO BASE DEL ENLACE (Píldora) */
    .nav-pills .nav-link {
        color: rgba(255, 255, 255, 0.75);
        transition: all 0.2s ease-in-out;
        margin: 4px 12px;
        border-radius: 8px;
        /* TRUCO DE ALINEACIÓN 1: Flexbox estricto */
        display: flex;
        align-items: center; /* Centra verticalmente */
        height: 45px; /* Altura fija para consistencia */
    }

        /* 3. EFECTO HOVER */
        .nav-pills .nav-link:not(.active):hover {
            color: white;
            background-color: rgba(255, 255, 255, 0.1);
            transform: translateX(4px);
        }

        /* 4. ENLACE ACTIVO */
        .nav-pills .nav-link.active {
            background: linear-gradient(45deg, #0d6efd, #0a58ca);
            color: white !important;
            font-weight: 600;
            box-shadow: 0 4px 6px rgba(0,0,0,0.2);
        }

    /* 5. TRUCO MAESTRO PARA LOS ICONOS */
    .bi {
        font-size: 1.25rem; /* Tamaño un poco más grande */
        /* ALINEACIÓN HORIZONTAL */
        min-width: 2rem; /* Ancho fijo: El texto siempre empieza en el mismo sitio */
        text-align: center; /* Centra el icono dentro de su espacio fijo */
        /* ALINEACIÓN VERTICAL */
        line-height: 1; /* Elimina espacios fantasma arriba/abajo */
        display: flex;
        justify-content: center;
        align-items: center;
        margin-right: 0.5rem; /* Separación con el texto */
    }
</style>

<div class="top-row ps-3 navbar navbar-dark bg-primary bg-gradient" style="--bs-bg-opacity: 0.9;">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold d-flex align-items-center" href="">
            <span class="bi bi-shop-window me-2"></span>
            <span>App Bocadillos</span>
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column nav-pills pt-3">

        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span> Inicio
            </NavLink>
        </div>

        <div class="nav-item mt-4 mb-2 px-4 text-white-50 text-uppercase fw-bold" style="font-size:0.7rem; letter-spacing: 1px;">
            Tienda
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="/ComprarBono/SelectBonoUI">
                <span class="bi bi-ticket-perforated-fill" aria-hidden="true"></span> Comprar Bonos
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="/Pedido/SelectBocadillosparaPedir">
                <span class="bi bi-bag-check-fill" aria-hidden="true"></span> Hacer Pedido
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="/SeleccionarMerch/SelectCompraMerch">
                <span class="bi bi-shop" aria-hidden="true"></span> Merchandising
            </NavLink>
        </div>

        <div class="nav-item mt-4 mb-2 px-4 text-white-50 text-uppercase fw-bold" style="font-size:0.7rem; letter-spacing: 1px;">
            Comunidad
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="/resenya/selectbocadillos">
                <span class="bi bi-star-half" aria-hidden="true"></span> Reseñas
            </NavLink>
        </div>

        <div class="nav-item mt-4 mb-2 px-4 text-white-50 text-uppercase fw-bold" style="font-size:0.7rem; letter-spacing: 1px;">
            Mi Cuenta
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item">
                    <NavLink class="nav-link" href="Account/Manage">
                        <span class="bi bi-person-circle" aria-hidden="true"></span> @context.User.Identity?.Name
                    </NavLink>
                </div>
                <div class="nav-item">
                    <form action="Account/Logout" method="post" class="m-0 w-100">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link w-100 bg-transparent border-0 text-start">
                            <span class="bi bi-box-arrow-left" aria-hidden="true"></span> Cerrar Sesión
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item">
                    <NavLink class="nav-link" href="Account/Register">
                        <span class="bi bi-person-plus-fill" aria-hidden="true"></span> Registrarse
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-box-arrow-in-right" aria-hidden="true"></span> Iniciar Sesión
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>

    </nav>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
// // }